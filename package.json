{
  "name": "loteria-en-cadena",
  "private": true,
  "version": "1.0.0",
  "description": "Lotería mexicana multijugador en 3D para la Polkadot App, Polkadot Desktop y Polkadot Web",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w3nerick/Loteria-On-Chain.git"
  },
  "keywords": [
    "loteria",
    "polkadot",
    "statement-store",
    "threejs",
    "vite",
    "multiplayer",
    "game"
  ],
  "scripts": {
    "dev": "vite --mode preview",
    "dev:host": "vite",
    "build": "vite build",
    "build:preview": "vite build --mode preview",
    "deploy": "npm run build && PAD_ENV=devnet pad dist loteria-on-chain.dot",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-force-exit test/*.test.mjs",
    "test:scale": "node --test --test-force-exit test/scale.test.mjs",
    "carga": "node scripts/carga.mjs",
    "icono": "node scripts/icono.mjs"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "@noble/hashes": "^1.8.0",
    "@parity/product-sdk-host": "0.19.1",
    "@parity/product-sdk-signer": "0.14.4",
    "@parity/product-sdk-statement-store": "0.6.9",
    "@scure/sr25519": "2.4.0",
    "polkadot-api": "~2.2.1",
    "three": "^0.180.0",
    "viem": "^2.57.1"
  },
  "devDependencies": {
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
